   "voice": "Zephyr",
   "archetype": "curious-kid"
  }
 ],
 "lines": [
  {
   "name": "Vy",
   "say": "Chào bạn, mình là Vy. Hôm nay mình chỉ bạn cách tạo kênh đầu tiên trong Gen-Studio nhé.",
   "terms": [],
   "mood": "calm"
  },
  {
   "name": "Vy",
   "say": "Đây là màn Tổng quan. Mọi kênh của xưởng nằm trong mục Kênh ở thanh bên trái.",
   "terms": [],
   "mood": "calm"
  },
  {
   "name": "Vy",
   "say": "Mình bấm vào Kênh để mở danh sách kênh.",
   "terms": [],
   "mood": "calm"
  },
  {
   "name": "Vy",
   "say": "Xưởng mới thì danh sách còn trống. Bấm nút Kênh mới ở góc trên bên phải.",
   "terms": [],
   "mood": "calm"
  },
  {
   "name": "Vy",
   "say": "Đây là biểu mẫu tạo kênh. Đầu tiên, gõ tên kênh, ví dụ Lớp AI Bình Dân.",
   "terms": [],
   "mood": "calm"
  },
  {
   "name": "Vy",
   "say": "Giờ sản xuất là lúc agent tự soạn bài mỗi ngày. Mình giữ sáu giờ sáng.",
   "terms": [],
   "mood": "calm"
  },
  {
   "name": "Vy",
   "say": "Cuộn xuống dưới một chút để xem phần giáo trình.",
   "terms": [],
   "mood": "calm"
  },
  {
   "name": "Vy",
   "say": "Muốn học chủ đề nào trước, cứ kéo nó lên đầu danh sách.",
   "terms": [],
   "mood": "calm"
  },
  {
   "name": "Vy",
   "say": "Bật lịch sản xuất để xưởng tự chạy mỗi sáng.",
   "terms": [],
   "mood": "calm"
  },
  {
   "name": "Vy",
   "say": "Cuối cùng bấm Lưu kênh, hoặc nhấn Ctrl S cho nhanh.",
   "terms": [],
   "mood": "calm"
  },
  {
   "name": "Vy",
   "say": "Thế là kênh mới đã hiện trong danh sách, trạng thái đang chạy.",
   "terms": [],
   "mood": "calm"
  },
  {
   "name": "Vy",
   "say": "Từ giờ, mỗi sáng agent sẽ tự soạn bài và gửi vào mục Duyệt.",
   "terms": [],
   "mood": "calm"
  },
  {
   "name": "Vy",
   "say": "Bạn chỉ việc mở Duyệt, xem video, rồi bấm duyệt là xong.",
   "terms": [],
   "mood": "calm"
  },
  {
   "name": "Vy",
   "say": "Chúc bạn tạo kênh thật vui nhé!",
   "terms": [],
   "mood": "calm"
  }
 ],
