# Image `agent`: chỉ runner + Claude Code CLI. KHÔNG volume dữ liệu, KHÔNG secret của studio, không Docker socket.
# Runner chạy root (compose: cap_drop ALL + SETUID/SETGID/CHOWN) và giữ refresh token ở /agent-state (0600); Claude CLI con chạy uid `node` (1000) và chỉ nhận access token (CNS-068).
# Claude Code CLI cài bằng npm global CHỈ ở image này (ASSET_MANIFEST); studio vẫn không cần npm.
FROM node:22-bookworm-slim

ARG CLAUDE_CODE_VERSION=latest
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
 && npm cache clean --force

WORKDIR /app
COPY agent/ /app/agent/

# phiên đăng nhập Claude Code của owner nằm ở /home/node/.claude (volume agent-home)
# token ghép thiết bị nằm ở /agent-state/token.json (volume agent-state, mode 0600), không ghi vào .env
RUN mkdir -p /home/node/.claude /agent-state && chown -R node:node /home/node && chmod 700 /agent-state
ENV HOME=/home/node \
    GS_MCP_URL=http://studio:7490/mcp \
    GS_AGENT_STATE=/agent-state \
    GS_CLI_UID=1000 GS_CLI_GID=1000 GS_CLI_HOME=/home/node
# KHÔNG đặt USER: runner cần quyền root để hạ quyền CLI con (spawn uid/gid); xem agent/runner.js cliSpawnOptions
VOLUME /home/node/.claude
VOLUME /agent-state
CMD ["node", "agent/runner.js"]
