# © 2026 Gen Labs — All rights reserved.
# Mẫu .env cho Gen-Studio. KHÔNG điền giá trị thật vào file này — chỉ để tham khảo tên biến.
# Bản cài thật: .env nằm ở gốc repo (dev) hoặc /opt/gen-studio/.env (prod GCP), quyền 600, KHÔNG commit.
# Chi tiết bí mật nào nằm ở đâu, hạn dùng, cách xoay: xem docs/SECRETS.md.

# --- cổng + định danh bản cài ---
GS_PORT=7490
GS_VERSION=local
COMPOSE_PROJECT_NAME=gen-studio

# --- chạy sau proxy (Caddy) trên GCP ---
GS_PUBLIC_URL=
GS_TRUST_PROXY=0

# --- user chạy container (khớp uid/gid chủ data/ trên máy chủ — install.sh/setup-vm.sh tự điền) ---
GS_UID=1000
GS_GID=1000

# --- ngôn ngữ giao diện mặc định ---
GS_LANG=vi

# --- bí mật ghép nội bộ studio<->agent (sinh tự động lúc `genstudio start` nếu trống, KHÔNG tự điền tay) ---
GS_PAIRING_SECRET=

# --- khoá chủ mã hoá khoá nhà cung cấp AI (sinh tự động trong data/.env khi cài lần đầu — KHÔNG đặt ở đây) ---
# GS_MASTER_KEY nằm trong data/.env (ngoài phạm vi bản sao lưu thường) — xem docs/SECRETS.md

# --- giọng offline (tuỳ chọn, profile voice) ---
COMPOSE_PROFILES=
GS_VOICE_PRECISION=fp32
GS_VOICE_JUDGE=small
GS_VOICE_THREADS=4
GS_VOICE_MEM=3g

# --- GCP: sao lưu offsite (đặt ở /opt/gs-deploy, KHÔNG đặt trong .env ứng dụng) ---
# GS_BUCKET=gs://<project>-gs-backup

# --- GCP: cảnh báo Telegram (đặt ở /opt/gs-deploy/alert.env, quyền 600, KHÔNG đặt trong .env ứng dụng) ---
# GS_ALERT_TG_TOKEN=
# GS_ALERT_TG_CHAT=
